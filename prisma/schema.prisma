generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Category {
  FOOD
  TRANSPORT
  SHOPPING
  BILLS
  SALARY
  OTHER
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean
  image         String
  role          UserRole      @default(USER)
  sessions      Session[]
  accounts      Account[]
  transactions  Transaction[]
  createdAt     DateTime      @default(now())

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// ৩. ট্রানজ্যাকশন মডেল (আমাদের TS Interface এর হুবহু রূপ)
model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float // টাকার পরিমাণ (Decimal বা Float)
  type        TransactionType // TS Enum এর সাথে মিল রেখে
  category    Category // TS Enum এর সাথে মিল রেখে
  description String? // '?' মানে Optional
  date        DateTime // খরচের তারিখ
  createdAt   DateTime        @default(now()) // অটোমেটিক সময় যুক্ত হবে

  @@index([userId]) // পারফরম্যান্সের জন্য ইনডেক্স
}
